# ── TinyLlama / llama.cpp server ─────────────────────────────────────────────
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_MODEL_PATH=models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LLAMA_CONTEXT_SIZE=4096
LLAMA_THREADS=4
LLAMA_GPU_LAYERS=0
LLAMA_BATCH_SIZE=512

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Memory tiers ─────────────────────────────────────────────────────────────
L1_MAX_TURNS=20
L1_MAX_TOKENS=2048
L2_MAX_TOKENS=4096
L2_SUMMARY_EVERY_N_TURNS=10
L3_MAX_RESULTS=8
L3_SIMILARITY_THRESHOLD=0.72
L4_MAX_RESULTS=5

# ── RAG ───────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/faiss_index
DOCUMENTS_PATH=data/documents
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=6
RAG_RERANK_TOP_N=3

# ── Fusion ────────────────────────────────────────────────────────────────────
FUSION_SEMANTIC_WEIGHT=0.45
FUSION_RECENCY_WEIGHT=0.25
FUSION_PRIORITY_WEIGHT=0.20
FUSION_IMPORTANCE_WEIGHT=0.10
FUSION_DEDUP_THRESHOLD=0.88
CONTEXT_TOKEN_BUDGET=3200
SYSTEM_TOKEN_RESERVE=256
CONVERSATION_TOKEN_RESERVE=512

# ── Generation defaults ───────────────────────────────────────────────────────
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.95
DEFAULT_TOP_K=40
DEFAULT_REPEAT_PENALTY=1.1

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=info
CORS_ORIGINS=*

# ── Security ─────────────────────────────────────────────────────────────────
API_KEY=changeme-in-production
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_PATH=data/synapseos.db
DATA_DIR=data
MODELS_DIR=models

# ── Development ───────────────────────────────────────────────────────────────
# Set to true to use mock LLM responses (no llama.cpp server needed)
MOCK_LLM=true
